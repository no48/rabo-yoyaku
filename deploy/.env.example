# rabo-yoyaku 環境変数テンプレート
# これを .env にコピーして値を埋める（.env はGit管理外）
#   cp .env.example .env
# 値は現在 Render の Environment に入っているものをそのまま移せばよい。

# --- Shopify（読み取り専用トークン推奨）---
SHOPIFY_SHOP=xdanqs-41.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_ここに読み取り専用トークン

# --- Basic認証（管理者ログイン）---
AUTH_USER=admin
AUTH_PASS=強いパスワードに変更

# --- メール送信（請求書・見積書のSMTP）---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=送信元メールアドレス
SMTP_PASS=アプリパスワード等
MAIL_FROM_NAME=ロープアクセスラボ
